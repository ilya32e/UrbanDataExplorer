MYSQL_DATABASE=urban_data_explorer
MYSQL_USER=urban
MYSQL_PASSWORD=urban
MYSQL_ROOT_PASSWORD=root
MYSQL_EXPOSE_PORT=3306
MONGO_DATABASE=urban_data_explorer
MONGO_EXPOSE_PORT=27017
REDIS_EXPOSE_PORT=6379
LB_EXPOSE_PORT=8080

# Observabilite de l'API (local-first)
API_RATE_LIMIT=240
API_RATE_WINDOW=60
API_SLOW_REQUEST_MS=750

# Authentification JWT / OAuth2 (seul mecanisme d'auth). Active par defaut :
# le frontend recupere lui-meme un JWT et se connecte directement.
# Ces identifiants doivent correspondre a ceux du frontend (frontend/app.js).
AUTH_SECRET_KEY=dev-secret-change-me-in-prod
AUTH_USERNAME=urban
AUTH_PASSWORD=urban
# AUTH_PASSWORD_SHA256=   # alternative recommandee : empreinte SHA-256 (remplace AUTH_PASSWORD)
AUTH_TOKEN_EXPIRE_MINUTES=60
