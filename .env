MYSQL_DATABASE=urban_data_explorer
MYSQL_USER=urban
MYSQL_PASSWORD=urban
MYSQL_ROOT_PASSWORD=root
MYSQL_EXPOSE_PORT=3306
MONGO_DATABASE=urban_data_explorer
MONGO_EXPOSE_PORT=27017

# --- Airflow ---
# Le worker Airflow et le conteneur `api` partagent le volume data/. `api` ecrit
# en root ; on aligne Airflow sur le meme uid (0) pour eviter les PermissionError
# sur le data lake partage (Silver/Gold).
AIRFLOW_UID=0

# --- Auth JWT / OAuth2 (C2.1) ---
# Local-first : laisser vide => API ouverte (le dashboard fonctionne sans token).
# Pour activer OAuth2/JWT, decommenter et definir un secret + des identifiants :
# AUTH_SECRET_KEY=change-me-long-random-secret
# AUTH_USERNAME=admin
# AUTH_PASSWORD=admin   # ou AUTH_PASSWORD_SHA256=<sha256(mot_de_passe)>
# AUTH_TOKEN_EXPIRE_MINUTES=60
